PORT=3001
# Generate your own random secret. Do not use this placeholder.
JWT_SECRET=replace_with_at_least_32_random_characters
# PostgreSQL from compose.yaml. Password = POSTGRES_PASSWORD in the root .env
# (URL-encode special characters, e.g. @ -> %40).
DATABASE_URL=postgres://app:replace_with_root_env_password@127.0.0.1:15432/agent_dev

# 模型配置可放在被Git忽略的 bknd/.env.ai，切换后重启后端。
AI_MODEL_PROVIDER=qwen
AI_QWEN_API_KEY=replace_locally
AI_QWEN_BASE_URL=https://your-region.example/compatible-mode/v1
AI_QWEN_MODEL=replace_with_available_model
# AI_DEEPSEEK_API_KEY=replace_locally
# AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_DEEPSEEK_MODEL=replace_with_available_model
# AI_GPT_API_KEY=replace_locally
# AI_GPT_BASE_URL=https://api.openai.com/v1
# AI_GPT_MODEL=replace_with_available_model
# AI_KIMI_API_KEY=replace_locally
# AI_KIMI_BASE_URL=https://replace_with_official_region_endpoint
# AI_KIMI_MODEL=replace_with_available_model
